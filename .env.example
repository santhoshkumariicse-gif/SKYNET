# ==============================================================================
# SKYNET Configuration Environment Variables
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security & Authentication
# In production, replace with cryptographically random secrets (min 32 characters)
SECRET_KEY=skynet_super_secret_jwt_key_enterprise_2026_prod_change_me
HMAC_SECRET=skynet_hmac_sha256_audit_key_enterprise_2026_change_me
ADMIN_INITIAL_PASSWORD=YourStrongAdminInitialPassword2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
AGENT_API_KEY=skynet_agent_default_secret_token_2026

# Database Configuration (PostgreSQL / SQLite fallback)
# If PostgreSQL is not available, backend automatically falls back to: sqlite+aiosqlite:///./skynet.db
POSTGRES_USER=skynet_admin
POSTGRES_PASSWORD=skynet_secure_password_2026
POSTGRES_DB=skynet_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://skynet_admin:skynet_secure_password_2026@localhost:5432/skynet_db

# In-Memory Cache & Session Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=skynet_redis_2026
REDIS_URL=redis://:skynet_redis_2026@localhost:6379/0

# Columnar Telemetry Store (ClickHouse)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=skynet_ch_password_2026
CLICKHOUSE_DB=skynet

# Threat Intelligence APIs (Optional for live enrichment; mock heuristics enabled by default)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# LLM Cognitive Engine Configuration (OpenAI or Local Ollama)
LLM_PROVIDER=mock_heuristic  # options: openai, ollama, mock_heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

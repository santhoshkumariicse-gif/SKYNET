    {
      "parameters": {
        "jsCode": "const a=$json.body ?? $json;\nconst score=a.alert?.risk?.score ?? 0;\nreturn [{json:{...a,soc:{stage:'soc',triage:{dedup_key:a.alert?.alert_id||a.event_id||Date.now(),priority:score>=80?'P1':score>=60?'P2':score>=30?'P3':'P4'}}}}];"
      },
      "id": "soc-triage",
      "name": "Alert Triage & Deduplication",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "disabled": false
    },
    {
      "parameters": {
        "jsCode": "const s=$json.soc||{};\nreturn [{json:{...$json,soc:{...s,ai_investigation:{\nstatus:'placeholder',\nhypothesis:'Requires configured AI provider',\nquestions:[],\nconfidence:null\n}}}}];"
      },
      "id": "soc-ai",
      "name": "AI Investigation Analyst",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "disabled": false
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,soc:{...$json.soc,evidence:{sources:[],artifacts:[],timeline:[]}}}}];"
      },
      "id": "soc-evidence",
      "name": "Evidence & Timeline Builder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "disabled": false
    },
    {
      "parameters": {
        "jsCode": "const p=$json.soc?.triage?.priority||'P4';\nreturn [{json:{...$json,incident:{\nincident_id:'INC-'+Date.now(),\nstatus:'open',\npriority:p,\nclassification:'unclassified',\nseverity:p==='P1'?'critical':p==='P2'?'high':p==='P3'?'medium':'low'\n}}}];"
      },
      "id": "soc-incident",
      "name": "Incident Creation & Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "disabled": false
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.incident.priority === 'P1' || $json.incident.priority === 'P2'}}",
              "operation": "isTrue"
            }
          ]
        }
      },
